{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codescene://skills/demo/report-data.schema.json",
  "type": "object",
  "required": ["project", "files"],
  "properties": {
    "project": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "health"],
        "properties": {
          "path": { "type": "string" },
          "health": { "type": "number", "minimum": 1, "maximum": 10 }
        }
      }
    }
  }
}
