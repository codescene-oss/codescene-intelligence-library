{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codescene://schemas/skill.schema.json",
  "title": "Skill",
  "description": "Metadata for one skill: skills/<id>/skill.json. The source of truth for catalog.json.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "audience",
    "min_server_version",
    "mcp_tools",
    "inputs",
    "skill",
    "data_schema",
    "renderers",
    "templates",
    "shared",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Same as the skill's folder name."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semver. Set by maintainers at release time."
    },
    "min_server_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semver. The lowest codescene-projects MCP server version that has every tool and argument the skill uses. Older servers hide the skill."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "mcp_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every CodeScene MCP tool the skill calls."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One input the skill collects. Becomes an MCP prompt argument. The value is typed with the same JSON Schema subset as $defs/value.",
        "required": [
          "name",
          "description",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Shown to users as the prompt argument's description."
          },
          "required": {
            "type": "boolean",
            "description": "Whether the argument must be given. Inputs with a default are never required."
          },
          "default": {
            "description": "Must validate against the input's type."
          },
          "type": {
            "enum": [
              "integer",
              "number",
              "boolean",
              "string",
              "array",
              "object"
            ]
          },
          "enum": {
            "type": "array",
            "minItems": 1
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "items": {
            "$ref": "#/$defs/value"
          },
          "properties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/value"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "array"
                }
              }
            },
            "then": {
              "required": [
                "items"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "object"
                }
              }
            },
            "then": {
              "required": [
                "properties"
              ]
            }
          }
        ]
      }
    },
    "skill": {
      "type": "string"
    },
    "data_schema": {
      "type": "string"
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "format": {
            "type": "string"
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "value": {
      "type": "object",
      "description": "A JSON Schema subset for one value. Objects require every listed property and allow no others.",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "integer",
            "number",
            "boolean",
            "string",
            "array",
            "object"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "items": {
          "$ref": "#/$defs/value"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties"
            ]
          }
        }
      ]
    }
  }
}
