{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codescene://schemas/skill.schema.json",
  "title": "Skill",
  "description": "Metadata for one skill: skills/<id>/skill.json. The source of truth for catalog.json.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "audience",
    "mcp_tools",
    "inputs",
    "skill",
    "data_schema",
    "renderers",
    "templates",
    "shared",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Same as the skill's folder name."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semver. Set by maintainers at release time."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "mcp_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every CodeScene MCP tool the skill calls."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "default": {}
        }
      }
    },
    "skill": {
      "type": "string"
    },
    "data_schema": {
      "type": "string"
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "format": {
            "type": "string"
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
