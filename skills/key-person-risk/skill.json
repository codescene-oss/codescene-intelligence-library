{
  "id": "key-person-risk",
  "version": "1.0.0",
  "title": "Key person risk report",
  "summary": "The project's truck factor and what leaves with each key person: CodeScene's off-boarding risks, the uplift targets that depend on one person, the components led by one person, and the knowledge already lost.",
  "audience": [
    "engineering-manager",
    "tech-lead"
  ],
  "mcp_tools": [
    "list_projects",
    "explore_project_files",
    "explore_project_components"
  ],
  "inputs": [
    {
      "name": "project_id",
      "required": true
    },
    {
      "name": "concentration_threshold",
      "default": 0.5
    }
  ],
  "skill": "SKILL.md",
  "data_schema": "report-data.schema.json",
  "renderers": [
    {
      "id": "html",
      "file": "renderers/report.html",
      "format": "text/html"
    }
  ],
  "templates": [
    "templates/project-notes.md"
  ],
  "shared": [
    "../../shared/ground-rules.md"
  ],
  "examples": [
    "examples/sample.report.json"
  ]
}
